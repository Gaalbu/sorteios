<!DOCTYPE html>
<html
  lang={if(@conn.assigns[:locale] == "pt_BR", do: "pt-BR", else: @conn.assigns[:locale] || "en")}
  class="h-full bg-gray-100"
>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content={csrf_token_value()} />
    <.live_title suffix=" · Sorteios">
      {assigns[:page_title] || gettext("Your own prize drawing app")}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={Routes.static_path(@conn, "/assets/app.css")} />
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={Routes.static_path(@conn, "/assets/app.js")}
    >
    </script>
  </head>
  <body class="h-full">
    <nav class="fixed right-4 top-2 z-50 text-xs">
      <a href={locale_path(@conn, "en")} class="mr-2">EN</a>
      <a href={locale_path(@conn, "pt_BR")}>PT-BR</a>
    </nav>
    {@inner_content}
  </body>
</html>
